{
  "name": "dsh-crawshrimp-browser",
  "version": "0.1.0",
  "description": "Independent, session-isolated browser tools for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.4 <0.2.1-alpha.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/howtimeschange/dsh-crawshrimp-browser.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "crawshrimp",
    "ecommerce",
    "browser"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2",
    "playwright-core": "1.64.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4"
  }
}
