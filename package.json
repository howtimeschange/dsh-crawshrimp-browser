{
  "name": "dsh-crawshrimp-browser",
  "version": "0.2.1",
  "description": "抓虾浏览器自动化插件：为 DeepSeek Harness（DSH）提供实时网页预览、多标签、人工接管、便携脚本和内置 Skill，可独立运行。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "LICENSE",
    "cordis.patch.yml",
    "locale",
    "icon.png",
    "docs",
    "skills",
    "scripts/sync-icon.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/preview/manager.js && node --check lib/preview/input.js && node --check lib/preview/transport.js && node --check lib/scripts/errors.js && node --check lib/scripts/manifest.js && node --check lib/scripts/runtime.js && node --check lib/scripts/index.js && node --check examples/save-storage-state.js && node --check examples/demo-adapter/read-table.js && node --check lib/permissions.js && node --check lib/skill.js && node scripts/sync-icon.mjs --check",
    "sync:icon": "node scripts/sync-icon.mjs",
    "prepack": "node scripts/sync-icon.mjs --check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.4 <0.2.1-alpha.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/howtimeschange/dsh-crawshrimp-browser.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "crawshrimp",
    "抓虾",
    "browser-automation",
    "playwright",
    "live-preview",
    "ecommerce",
    "agent-skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2",
    "playwright-core": "1.64.1",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.4"
  }
}
